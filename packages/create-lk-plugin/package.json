{
  "name": "create-lk-plugin",
  "version": "0.0.1",
  "description": "CLI scaffold tool for creating Live Knowledge plugins",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "create-lk-plugin": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup src/cli.ts src/index.ts --format cjs --dts",
    "dev": "tsup src/cli.ts src/index.ts --format cjs --dts --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest --run",
    "test:watch": "vitest",
    "verify-template": "npx tsx scripts/verify-template.ts"
  },
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.0.0",
    "eslint": "^9.36.0",
    "fast-check": "^3.23.2",
    "inquirer": "^8.2.7",
    "prettier": "^3.7.4",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.1.8"
  },
  "files": [
    "dist",
    "template"
  ],
  "keywords": [
    "live-knowledge",
    "plugin",
    "scaffold",
    "cli"
  ],
  "license": "MIT"
}
